rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // STAGED PRODUCTION RULES — DO NOT DEPLOY UNTIL AUTHENTICATED ADMIN UID DOCS
    // (/admins/{uid}) AND PHP BACKEND ROUTES ARE VERIFIED ON IONOS.
    // All privileged writes (orders, tracking, reviews, coupons, wholesale, inventory,
    // and store settings) are executed server-side by PHP via Google Service Account OAuth2.

    // Global Safety Net: Default-deny all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Strict DB-backed Admin Role Verification (no hardcoded personal email)
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['admin', 'super_admin', 'superadmin'];
    }

    // 0. Admins Registry (Signed-in user can check own admin status doc; no public listing/writes)
    match /admins/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // 1. Products Collection (Public read, Admin read/write via PHP or authenticated Admin Console)
    match /products/{productId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(productId) && isAdmin();
    }

    // 2. Categories Collection (Public read, Admin write only)
    match /categories/{categoryId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(categoryId) && isAdmin();
    }

    // 3. Shahi Mix Boxes & Ingredients (Public read, Admin write only)
    match /shahi_boxes/{boxId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(boxId) && isAdmin();
    }

    match /shahi_ingredients/{ingredientId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(ingredientId) && isAdmin();
    }

    function isValidBankDetails(bd) {
      return bd is map
        && bd.keys().hasOnly(['bankName', 'accountTitle', 'accountNumber', 'iban', 'raastId'])
        && (!('bankName' in bd) || (bd.bankName is string && bd.bankName.size() <= 100))
        && (!('accountTitle' in bd) || (bd.accountTitle is string && bd.accountTitle.size() <= 100))
        && (!('accountNumber' in bd) || (bd.accountNumber is string && bd.accountNumber.size() <= 60))
        && (!('iban' in bd) || (bd.iban is string && bd.iban.size() <= 60))
        && (!('raastId' in bd) || (bd.raastId is string && bd.raastId.size() <= 60));
    }

    function isValidPublicSettings(data) {
      return data is map
        && data.keys().hasOnly([
          'storeName',
          'tagline',
          'contactPhone',
          'whatsappNumber',
          'contactEmail',
          'freeShippingThreshold',
          'standardShippingRate',
          'codEnabled',
          'bankDetails',
          'announcementBarMessage',
          'announcementActive'
        ])
        && (!('storeName' in data) || (data.storeName is string && data.storeName.size() <= 100))
        && (!('tagline' in data) || (data.tagline is string && data.tagline.size() <= 200))
        && (!('contactPhone' in data) || (data.contactPhone is string && data.contactPhone.size() <= 30))
        && (!('whatsappNumber' in data) || (data.whatsappNumber is string && data.whatsappNumber.size() <= 30))
        && (!('contactEmail' in data) || (data.contactEmail is string && data.contactEmail.size() <= 100))
        && (!('freeShippingThreshold' in data) || (data.freeShippingThreshold is number && data.freeShippingThreshold >= 0))
        && (!('standardShippingRate' in data) || (data.standardShippingRate is number && data.standardShippingRate >= 0))
        && (!('codEnabled' in data) || data.codEnabled is bool)
        && (!('announcementBarMessage' in data) || (data.announcementBarMessage is string && data.announcementBarMessage.size() <= 300))
        && (!('announcementActive' in data) || data.announcementActive is bool)
        && (!('bankDetails' in data) || isValidBankDetails(data.bankDetails));
    }

    // 4a. Public Storefront Settings (Strictly allowlisted public display & checkout payment fields only)
    match /public_settings/{settingId} {
      allow get: if settingId == 'main' || isAdmin();
      allow list: if isAdmin();
      allow create, update: if settingId == 'main' && isAdmin() && isValidPublicSettings(request.resource.data);
      allow delete: if false;
    }

    // 4b. Private Operational & Financial Settings (Admin read only; writes via PHP backend Service Account only)
    match /private_settings/{settingId} {
      allow get: if isAdmin();
      allow list, create, update, delete: if false;
    }

    // 4c. Legacy Settings Collection (LOCKED DOWN: zero public or non-admin customer reads/writes)
    match /settings/{settingId} {
      allow get: if isAdmin();
      allow list, create, update, delete: if false;
    }

    // 5. Orders Collection (Zero public access; Admin list/get only; ALL creates/updates via PHP backend)
    match /orders/{orderId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    // 6. Order Idempotency Keys (Backend-only via Service Account)
    match /order_idempotency/{idempotencyKey} {
      allow read, write: if false;
    }

    // 7. Reviews Collection (Public read ONLY when approved; creation & moderation via PHP backend)
    match /reviews/{reviewId} {
      allow get: if (resource != null && resource.data.status == 'approved') || isAdmin();
      allow list: if resource.data.status == 'approved' || isAdmin();
      allow create, update, delete: if false;
    }

    // 8. Coupons Collection (Admin read/write only; public validation runs through POST /api/coupons/validate)
    match /coupons/{couponId} {
      allow get, list, create, update, delete: if isValidId(couponId) && isAdmin();
    }

    // 9. Wholesale Inquiries Collection (Admin read only; submission & status updates via PHP backend)
    match /wholesale_inquiries/{inquiryId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }
  }
}
