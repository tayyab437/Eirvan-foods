# Eirvan Foods — IONOS Apache Production Configuration
Options -Indexes -MultiViews
ServerSignature Off

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pass Authorization Bearer tokens to PHP CGI/FPM (critical for Firebase ID tokens on IONOS)
    RewriteCond %{HTTP:Authorization} ^(.*)
    RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]

    # Force HTTPS in production
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Route /api/* exclusively to PHP front controller
    RewriteRule ^api(/.*)?$ api/index.php [L,QSA]

    # Never rewrite missing static asset files to index.html
    RewriteCond %{REQUEST_URI} \.(?:js|css|webp|png|jpg|jpeg|svg|ico|woff2?|json|txt|webmanifest|xml)$ [NC]
    RewriteRule ^ - [L]

    # React SPA History Fallback
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>

# Block access to hidden dotfiles, backups, and server files
<FilesMatch "(^\.|composer\.json|composer\.lock|package\.json|package-lock\.json|\.env|secrets\.php|service-account\.json)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

    # Do not cache HTML SPA shell or service worker
    <FilesMatch "^(index\.html|sw\.js|registerSW\.js|manifest\.webmanifest)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>

    # Long-term immutable cache for Vite hashed assets
    <FilesMatch "\.(?:js|css|webp|png|jpg|svg|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>
