rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'ac.repair.in.dubai3@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Entity Validations
    function isValidProduct(data) {
      return data.id is string &&
             data.name is string && data.name.size() <= 200 &&
             data.slug is string && data.slug.size() <= 150 &&
             data.category is string &&
             data.variants is list && data.variants.size() > 0 &&
             data.variants.size() <= 30;
    }

    function isValidOrder(data) {
      return data.orderNumber is string && data.orderNumber.size() <= 32 &&
             data.customerName is string && data.customerName.size() <= 100 &&
             data.customerPhone is string && data.customerPhone.size() <= 30 &&
             data.city is string && data.city.size() <= 50 &&
             data.address is string && data.address.size() <= 300 &&
             data.items is list && data.items.size() > 0 && data.items.size() <= 50 &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.paymentMethod in ['COD', 'BankTransfer', 'Raast'] &&
             data.orderStatus in ['Pending', 'Confirmed', 'Processing', 'Packed', 'Shipped', 'Delivered', 'Cancelled', 'Returned'];
    }

    function isValidReview(data) {
      return data.productId is string && data.productId.size() <= 64 &&
             data.customerName is string && data.customerName.size() <= 100 &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() <= 1000 &&
             data.status in ['approved', 'pending', 'rejected'];
    }

    function isValidCoupon(data) {
      return data.code is string && data.code.size() <= 30 &&
             data.discountType in ['percentage', 'fixed'] &&
             data.discountValue is number && data.discountValue > 0 &&
             data.minOrderAmount is number &&
             data.isActive is bool;
    }

    function isValidStoreSettings(data) {
      return data.storeName is string && data.storeName.size() <= 100 &&
             data.contactPhone is string && data.contactPhone.size() <= 30 &&
             data.whatsappNumber is string && data.whatsappNumber.size() <= 30 &&
             data.freeShippingThreshold is number &&
             data.standardShippingRate is number;
    }

    function isValidWholesaleInquiry(data) {
      return data.keys().hasAll([
               'id', 'createdAt', 'companyName', 'contactName', 'phone', 'email',
               'inquiryType', 'estimatedQuantity', 'message', 'status'
             ]) &&
             data.keys().hasOnly([
               'id', 'createdAt', 'companyName', 'contactName', 'phone', 'email',
               'inquiryType', 'estimatedQuantity', 'eventDate', 'message', 'status'
             ]) &&
             data.id is string && data.id.size() <= 128 &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             data.companyName is string && data.companyName.size() >= 1 && data.companyName.size() <= 100 &&
             data.contactName is string && data.contactName.size() >= 1 && data.contactName.size() <= 100 &&
             data.phone is string && data.phone.size() >= 3 && data.phone.size() <= 30 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 100 &&
             data.inquiryType in ['Corporate Gifting', 'Wholesale Purchase', 'Wedding Favors', 'Other'] &&
             data.estimatedQuantity is string && data.estimatedQuantity.size() >= 1 && data.estimatedQuantity.size() <= 100 &&
             (!('eventDate' in data) || (data.eventDate is string && data.eventDate.size() <= 32)) &&
             data.message is string && data.message.size() <= 2000 &&
             data.status in ['New', 'Contacted', 'Quoted', 'Converted', 'Closed'];
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['id', 'name']) &&
             data.keys().hasOnly(['id', 'name', 'image', 'description', 'isSystem']) &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
             (!('image' in data) || (data.image is string && data.image.size() <= 500)) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 300)) &&
             (!('isSystem' in data) || data.isSystem is bool);
    }

    // 1. Products Collection (Public browse, admin write)
    match /products/{productId} {
      allow get, list: if true;
      allow create: if isValidId(productId) && (isAdmin() || isValidProduct(incoming()));
      allow update: if isValidId(productId) && (isAdmin() || isValidProduct(incoming()));
      allow delete: if isValidId(productId);
    }

    // 2. Orders Collection (Customer order placement and tracking)
    match /orders/{orderId} {
      allow get, list: if true;
      allow create: if isValidId(orderId) && isValidOrder(incoming());
      allow update: if isValidId(orderId) && (
        isAdmin() ||
        incoming().diff(existing()).affectedKeys().hasOnly([
          'orderStatus', 'paymentStatus', 'trackingNumber', 'courier', 'internalNotes'
        ])
      );
      allow delete: if isValidId(orderId) && isAdmin();
    }

    // 3. Reviews Collection (Public read, verified creation)
    match /reviews/{reviewId} {
      allow get, list: if true;
      allow create: if isValidId(reviewId) && isValidReview(incoming());
      allow update: if isValidId(reviewId) && (isAdmin() || incoming().diff(existing()).affectedKeys().hasOnly(['status']));
      allow delete: if isValidId(reviewId) && isAdmin();
    }

    // 4. Coupons Collection (Public read, admin write)
    match /coupons/{couponId} {
      allow get, list: if true;
      allow create: if isValidId(couponId) && (isAdmin() || isValidCoupon(incoming()));
      allow update: if isValidId(couponId) && (isAdmin() || incoming().diff(existing()).affectedKeys().hasOnly(['usageCount', 'isActive']));
      allow delete: if isValidId(couponId);
    }

    // 5. Settings Collection (Public read, admin write)
    match /settings/{settingId} {
      allow get, list: if true;
      allow create: if isValidId(settingId) && (isAdmin() || isValidStoreSettings(incoming()));
      allow update: if isValidId(settingId) && (isAdmin() || isValidStoreSettings(incoming()));
      allow delete: if isValidId(settingId) && isAdmin();
    }

    // 6. Wholesale Inquiries Collection (Public create with status 'New', Admin read/update/delete)
    match /wholesale_inquiries/{inquiryId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(inquiryId) && isValidWholesaleInquiry(incoming()) && incoming().status == 'New';
      allow update: if isValidId(inquiryId) && isAdmin() && isValidWholesaleInquiry(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().id == existing().id;
      allow delete: if isValidId(inquiryId) && isAdmin();
    }

    // 7. Categories Collection (Public browse, admin write)
    match /categories/{categoryId} {
      allow get, list: if true;
      allow create: if isValidId(categoryId) && isAdmin() && isValidCategory(incoming());
      allow update: if isValidId(categoryId) && isAdmin() && isValidCategory(incoming());
      allow delete: if isValidId(categoryId) && isAdmin();
    }
  }
}
